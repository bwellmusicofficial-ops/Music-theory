# Names of the settings the account features read. Copy to .env.local and fill in the secret.
# NEVER commit a file with a real secret. .env.local is ignored by git.

# Public: safe to be in the browser and in this file.
NEXT_PUBLIC_SUPABASE_URL=https://rnefqcvlxbvhacyjmknz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CviqSlSdQVKOzn13uTzyPA_hKmthc9Q

# SECRET: server only. Supabase "secret key" (replaces service_role). Set in Vercel, never here.
SUPABASE_SECRET_KEY=replace-me-with-the-secret-key-from-supabase

# The switch. Unset or 0 = no account UI and /api/account/* answers 404 (production for now).
# Set to 1 in Vercel's Preview environment to test. Read at BUILD time, so redeploy after changing it.
NEXT_PUBLIC_ACCOUNTS_ENABLED=0

# Tests only (the Playwright server sets these). Needs NEXT_PUBLIC_ENABLE_DEV_ROUTES=1 or it is refused.
# ACCOUNTS_FAKE_BACKEND=1
# NEXT_PUBLIC_ENABLE_DEV_ROUTES=1
