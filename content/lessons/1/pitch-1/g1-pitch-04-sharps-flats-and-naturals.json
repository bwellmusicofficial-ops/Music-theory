  "id": "g1-pitch-04-sharps-flats-and-naturals",
  "title": "Sharps, flats and naturals",
  "summary": "Play the black keys, name them two ways and see how long a sign lasts.",
  "grade": "1",
  "unit": "pitch-1",
  "order": 4,
  "strand": "pitch",
  "skills": [
