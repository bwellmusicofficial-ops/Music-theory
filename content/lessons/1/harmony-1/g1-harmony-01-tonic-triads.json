    "name": {
      "cards": [
        {
          "text": "Notes played together make a [[chord|chord]]. A chord of three notes stacked in 3rds is a [[triad|triad]]: a note, the note a [[3rd|3rd]] above it, and the note a [[5th|5th]] above it. In a scale they are notes 1, 3 and 5.",
          "exhibit": {
            "kind": "passage",
            "tempo": 60,
            "passage": {
              "clef": "treble",
              "key": {
                "tonic": {
