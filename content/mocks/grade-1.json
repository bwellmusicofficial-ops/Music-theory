        {
          "kind": "authored",
          "id": "dynamics",
          "bank": [
            {
              "id": "dynamics-piano",
              "type": "multiple-choice",
              "skill": "terms.dynamics.signs",
              "prompt": "What does the sign *p* mean?",
              "source": "authored",
              "payload": {
                "options": [
                  {
                    "id": "a",
                    "face": {
                      "kind": "text",
                      "text": "Quiet (piano)"
                    }
                  },
                  {
                    "id": "b",
                    "face": {
                      "kind": "text",
                      "text": "Loud (forte)"
                    },
                    "reason": "That is f. The letter p stands for piano, which means quiet."
                  },
                  {
                    "id": "c",
                    "face": {
                      "kind": "text",
                      "text": "Very quiet (pianissimo)"
                    },
                    "reason": "That is pp, with two letters. A single p means quiet."
                  },
                  {
                    "id": "d",
                    "face": {
                      "kind": "text",
                      "text": "Moderately quiet (mezzo piano)"
                    },
                    "reason": "That is mp. A single p on its own means quiet."
                  }
                ],
                "correct": "a"
              }
            },
            {
              "id": "dynamics-mezzo-forte",
              "type": "multiple-choice",
              "skill": "terms.dynamics.signs",
              "prompt": "Which sign means moderately loud?",
              "source": "authored",
              "payload": {
                "options": [
                  {
                    "id": "a",
                    "face": {
                      "kind": "text",
                      "text": "*mp*"
                    },
                    "reason": "The sign mp means moderately quiet. Moderately loud is mf."
                  },
                  {
                    "id": "b",
                    "face": {
                      "kind": "text",
                      "text": "*mf*"
                    }
                  },
                  {
                    "id": "c",
                    "face": {
                      "kind": "text",
                      "text": "*f*"
                    },
                    "reason": "The sign f means loud, which is louder than moderately loud. Moderately loud is mf."
                  },
                  {
                    "id": "d",
                    "face": {
                      "kind": "text",
                      "text": "*ff*"
                    },
                    "reason": "The sign ff means very loud. Moderately loud is mf."
                  }
                ],
                "correct": "b"
              }
            },
            {
              "id": "dynamics-crescendo",
              "type": "multiple-choice",
              "skill": "terms.dynamics.signs",
              "prompt": "What does [[crescendo|crescendo]] (cresc.) mean?",
              "source": "authored",
              "payload": {
                "options": [
                  {
                    "id": "a",
                    "face": {
                      "kind": "text",
                      "text": "Gradually getting quieter"
                    },
                    "reason": "That is diminuendo (dim.) or decrescendo. Crescendo means gradually getting louder."
                  },
                  {
                    "id": "b",
                    "face": {
                      "kind": "text",
                      "text": "Gradually getting faster"
                    },
                    "reason": "Crescendo is about loudness, not speed. Getting faster is accelerando."
                  },
                  {
                    "id": "c",
                    "face": {
                      "kind": "text",
                      "text": "Gradually getting louder"
                    }
                  },
                  {
                    "id": "d",
                    "face": {
                      "kind": "text",
                      "text": "Suddenly very loud"
                    },
                    "reason": "Crescendo is a gradual change, not a sudden one. It means gradually getting louder."
                  }
                ],
                "correct": "c"
              }
            },
            {
              "id": "dynamics-diminuendo",
              "type": "multiple-choice",
              "skill": "terms.dynamics.signs",
              "prompt": "What does [[diminuendo|diminuendo]] (dim.) mean?",
              "source": "authored",
              "payload": {
                "options": [
                  {
                    "id": "a",
                    "face": {
                      "kind": "text",
                      "text": "Gradually getting louder"
                    },
                    "reason": "That is crescendo, the opposite. Diminuendo means gradually getting quieter."
                  },
                  {
                    "id": "b",
                    "face": {
                      "kind": "text",
                      "text": "Gradually getting quieter"
                    }
                  },
                  {
                    "id": "c",
                    "face": {
                      "kind": "text",
                      "text": "Gradually getting slower"
                    },
                    "reason": "Diminuendo is about loudness, not speed. Getting slower is ritardando."
                  },
                  {
                    "id": "d",
                    "face": {
                      "kind": "text",
                      "text": "Very quiet"
                    },
                    "reason": "Very quiet is pp (pianissimo). Diminuendo is a gradual change: gradually getting quieter."
                  }
                ],
                "correct": "b"
              }
            },
            {
              "id": "dynamics-match",
              "type": "match-up",
              "skill": "terms.dynamics.signs",
              "prompt": "Match each dynamic sign to its meaning.",
              "source": "authored",
              "payload": {
                "left": [
                  {
                    "id": "l1",
                    "face": {
                      "kind": "text",
