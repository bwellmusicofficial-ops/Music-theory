                    },
                    "match": "r4",
                    "reason": "Moderato means at a moderate speed. Pair it with \"At a moderate speed\"."
                  }
                ],
                "right": [
                  {
                    "id": "r3",
                    "face": {
                      "kind": "text",
                      "text": "At a walking pace"
                    }
                  },
                  {
                    "id": "r1",
