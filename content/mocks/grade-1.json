        {
          "kind": "authored",
          "id": "tempo-and-expression",
          "bank": [
            {
              "id": "tempo-allegro",
              "type": "multiple-choice",
              "skill": "terms.tempo.italian",
              "prompt": "What does [[allegro|allegro]] mean?",
              "source": "authored",
              "payload": {
                "options": [
                  {
                    "id": "a",
                    "face": {
                      "kind": "text",
                      "text": "Slow and calm"
                    },
                    "reason": "That is adagio. Allegro is the opposite: quick and lively."
                  },
                  {
                    "id": "b",
                    "face": {
                      "kind": "text",
                      "text": "Quick and lively"
                    }
                  },
                  {
                    "id": "c",
                    "face": {
                      "kind": "text",
                      "text": "At a walking pace"
                    },
                    "reason": "That is andante, a medium speed. Allegro is quicker: quick and lively."
                  },
                  {
                    "id": "d",
                    "face": {
                      "kind": "text",
                      "text": "Gradually getting faster"
                    },
                    "reason": "That describes accelerando, which is a change of speed. Allegro is a steady quick speed: quick and lively."
                  }
                ],
                "correct": "b"
              }
            },
            {
              "id": "tempo-adagio",
              "type": "multiple-choice",
              "skill": "terms.tempo.italian",
              "prompt": "What does [[adagio|adagio]] mean?",
              "source": "authored",
              "payload": {
                "options": [
                  {
                    "id": "a",
                    "face": {
                      "kind": "text",
                      "text": "Quick and lively"
                    },
                    "reason": "That is allegro, the opposite of adagio. Adagio means slow and calm."
                  },
                  {
                    "id": "b",
                    "face": {
                      "kind": "text",
                      "text": "At a moderate speed"
                    },
                    "reason": "That is moderato. Adagio is much slower: slow and calm."
                  },
                  {
                    "id": "c",
                    "face": {
                      "kind": "text",
                      "text": "Slow and calm"
                    }
                  },
                  {
                    "id": "d",
                    "face": {
                      "kind": "text",
                      "text": "Return to the original speed"
                    },
                    "reason": "That is a tempo, which cancels a change of speed. Adagio means slow and calm."
                  }
                ],
                "correct": "c"
              }
            },
            {
              "id": "tempo-ritardando",
              "type": "multiple-choice",
              "skill": "terms.tempo.italian",
              "prompt": "Which word means gradually getting slower?",
              "source": "authored",
              "payload": {
                "options": [
                  {
                    "id": "a",
                    "face": {
                      "kind": "text",
                      "text": "ritardando (rit.)"
                    }
                  },
                  {
                    "id": "b",
                    "face": {
                      "kind": "text",
                      "text": "accelerando (accel.)"
                    },
                    "reason": "Accelerando means gradually getting faster, the opposite of what is asked."
                  },
                  {
                    "id": "c",
                    "face": {
                      "kind": "text",
                      "text": "allegretto"
                    },
                    "reason": "Allegretto is a fixed speed, quite quick. It does not describe a gradual change."
                  },
                  {
                    "id": "d",
                    "face": {
                      "kind": "text",
                      "text": "a tempo"
                    },
                    "reason": "A tempo means go back to the original speed. It does not make the music slower."
                  }
                ],
                "correct": "a"
              }
            },
            {
              "id": "expression-cantabile",
              "type": "multiple-choice",
              "skill": "terms.expression.italian",
              "prompt": "What does [[cantabile|cantabile]] mean?",
              "source": "authored",
              "payload": {
                "options": [
                  {
                    "id": "a",
                    "face": {
                      "kind": "text",
                      "text": "Short and detached"
                    },
                    "reason": "That is staccato, which describes how notes are separated. Cantabile means in a singing style."
                  },
                  {
                    "id": "b",
                    "face": {
                      "kind": "text",
                      "text": "Very loud"
                    },
                    "reason": "Loudness is shown by words such as fortissimo. Cantabile means in a singing style."
                  },
                  {
                    "id": "c",
                    "face": {
                      "kind": "text",
                      "text": "Sweet and soft"
                    },
                    "reason": "That is dolce. Cantabile is a different word: in a singing style."
                  },
                  {
                    "id": "d",
                    "face": {
                      "kind": "text",
                      "text": "In a singing style"
                    }
                  }
                ],
                "correct": "d"
              }
            },
            {
              "id": "tempo-match",
              "type": "match-up",
              "skill": "terms.tempo.italian",
              "prompt": "Match each tempo word to its meaning.",
              "source": "authored",
